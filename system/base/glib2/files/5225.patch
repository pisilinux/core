 						 GType               is_a_type) G_GNUC_PURE;
 GOBJECT_AVAILABLE_IN_ALL
-gboolean	 g_type_check_is_value_type     (GType		     type) G_GNUC_CONST;
+gboolean	 g_type_check_is_value_type     (GType		     type) G_GNUC_PURE;
 GOBJECT_AVAILABLE_IN_ALL

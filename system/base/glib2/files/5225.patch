 GOBJECT_AVAILABLE_IN_ALL
@@ -2647,7 +2647,7 @@ gboolean	 g_type_check_value_holds	(const GValue	    *value,
 						 GType		     type) G_GNUC_PURE;
 GOBJECT_AVAILABLE_IN_ALL
